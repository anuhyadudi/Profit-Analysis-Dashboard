      <aliases enabled='yes' />
      <column caption='Profit Margin' datatype='real' name='[Calculation_0552235754852352]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Profit])/SUM([Sales]))*100' />
      </column>
      <column caption='Profit Formatted' datatype='string' name='[Calculation_0552235829579803]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &gt;= 1000 &#13;&#10;THEN STR(ROUND(SUM([Profit])/1000, 1)) + &quot;K&quot;&#13;&#10;ELSE STR(ROUND(SUM([Profit]), 0))&#13;&#10;END' />
      </column>
      <column caption='Sales Formatted' datatype='string' name='[Calculation_0552235829727260]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Sales]) &gt;= 1000 &#13;&#10;THEN STR(ROUND(SUM([Sales])/1000, 1)) + &quot;K&quot;&#13;&#10;ELSE STR(ROUND(SUM([Sales]), 0))&#13;&#10;END' />
      </column>
      <column caption='Year Profit' datatype='real' name='[Calculation_0552236055359517]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date]) = INT([Parameters].[Parameter 1])&#13;&#10;THEN [Profit]&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Previous Year Profit' datatype='real' name='[Calculation_0552236055908382]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date]) = INT([Parameters].[Parameter 1]) - 1&#13;&#10;THEN [Profit]&#13;&#10;END' />
      </column>
      <column caption='YoY Change %' datatype='real' name='[Calculation_0552236056010783]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='((SUM([Calculation_0552236055359517])-SUM([Calculation_0552236055908382])) &#13;&#10;/ ABS(SUM([Calculation_0552236055908382])))*100' />
      </column>
      <column caption='YoY Display pos' datatype='string' name='[Calculation_0552236069478432]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0552236056010783] &gt; 0&#13;&#10;THEN &quot;▲ &quot;&#13;&#10;END' />
      </column>
      <column caption='Year Margin' datatype='real' name='[Calculation_0552236073721891]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 1]&#13;&#10;THEN (SUM([Calculation_0552236055359517]) / SUM([Calculation_0552236075925542]))&#13;&#10;END' />
      </column>
      <column caption='Previous Year Margin' datatype='real' name='[Calculation_0552236073771044]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 1] - 1&#13;&#10;THEN [Profit] / [Sales]&#13;&#10;END' />
      </column>
      <column caption='Margin YoY Display' datatype='real' name='[Calculation_0552236073881637]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Calculation_0552236073721891]) &gt; SUM([Calculation_0552236073771044])&#13;&#10;THEN SUM([Calculation_0552236073721891]) - SUM([Calculation_0552236073771044])&#13;&#10;END' />
      </column>
      <column caption='Year Sales' datatype='real' name='[Calculation_0552236075925542]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 1]&#13;&#10;THEN [Sales]&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
