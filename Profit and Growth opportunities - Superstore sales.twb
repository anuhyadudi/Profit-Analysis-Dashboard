    <worksheet name='KPI'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>Total Profit / Avg Profit Margin</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='sample_-_superstore' name='federated.125jfdj05w45w519h5erd0jt7uj6' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Selected Year Parameter' datatype='integer' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='2024'>
              <calculation class='tableau' formula='2024' />
              <range max='2026' min='2023' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.125jfdj05w45w519h5erd0jt7uj6'>
            <column caption='Profit Margin' datatype='real' name='[Calculation_0552235754852352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Profit])/SUM([Sales]))*100' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_0552235818315780]' role='measure' type='quantitative' user:unnamed='Sheet 5'>
              <calculation class='tableau' formula='0' />
            </column>
            <column caption='0' datatype='integer' name='[Calculation_0552235821797392]' role='measure' type='quantitative' user:unnamed='Sheet 5'>
              <calculation class='tableau' formula='0' />
